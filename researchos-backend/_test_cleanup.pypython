import sys  sys.path.insert(0, '.')  from routers.rag_router import _rag_sessions  from datetime import datetime, timezone, timedelta  for i in range(5):      _rag_sessions[f'old-session-{i}'] = {'user_id': 999, 'filename': f'old_file_{i}.pdf', 'status': 'ready', 'created_at': (datetime.now(timezone.utc) - timedelta(hours=25)).isoformat(), 'history': []}  print(f'Before cleanup: {len(_rag_sessions)} sessions in memory')  now = datetime.now(timezone.utc)  removed = 0  for sid, session in list(_rag_sessions.items()):      created_raw = session.get('created_at', '')      if not created_raw: continue      created_at = datetime.fromisoformat(str(created_raw))      if created_at.tzinfo is None: created_at = created_at.replace(tzinfo=timezone.utc)      age_hours = (now - created_at).total_seconds() / 3600      if age_hours > 24 and session.get('status') != 'processing':          del _rag_sessions[sid]          removed += 1  print(f'Removed: {removed} expired sessions')  print(f'After cleanup: {len(_rag_sessions)} sessions in memory')  _test_cleanup.pydel _test_cleanup.py
