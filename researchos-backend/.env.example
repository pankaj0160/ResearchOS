# =============================================================================
# ResearchOS — Environment Variables
# Copy this to .env and fill in your values
# =============================================================================

# ── Groq (comma-separated for key rotation) ──
# GROQ_API_KEYS=gsk_key1,gsk_key2

# ── Tavily (comma-separated for key rotation) ──
# TAVILY_API_KEYS=tvly_key1

# ── Auth ──
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# ── CORS ──
FRONTEND_ORIGIN=http://localhost:5173

# ── Optional: Email (for forgot-password in production) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password

# ── Optional: IP geolocation (for AI Dashboard) ──
# IPINFO_TOKEN=your_ipinfo_token
